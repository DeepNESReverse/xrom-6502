{
  "name": "@xromdev/cpu6502",
  "version": "0.1.0",
  "description": "The NES's 6502 CPU in TypeScript: all 256 opcodes, cycle counts, a bus you plug memory into.",
  "license": "MIT",
  "author": "Oleksandr Maksymov",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "6502",
    "nes",
    "famicom",
    "2a03",
    "cpu",
    "emulator",
    "disassembler"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeepNESReverse/xrom-6502.git"
  },
  "homepage": "https://github.com/DeepNESReverse/xrom-6502#readme",
  "bugs": {
    "url": "https://github.com/DeepNESReverse/xrom-6502/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
